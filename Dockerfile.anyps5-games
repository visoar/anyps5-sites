FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY anyps5.cc/package.json ./anyps5.cc/package.json
COPY anyps5.games/package.json ./anyps5.games/package.json
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build:games

FROM nginx:stable-alpine
COPY deploy/nginx-games.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/anyps5.games/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
