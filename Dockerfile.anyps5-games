ARG ASSET_STAGE=builder
FROM node:24.22.2-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY anyps5.cc/package.json ./anyps5.cc/package.json
COPY anyps5.games/package.json ./anyps5.games/package.json
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build:games && mv anyps5.games/dist /dist

FROM scratch AS prebuilt
COPY anyps5.games/dist/ /dist/

FROM ${ASSET_STAGE} AS assets

FROM nginx/nginx-unprivileged:1.30.6-alpine-slim
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/visoar/anyps5-sites" \
      org.opencontainers.image.revision=$SOURCE_COMMIT
COPY --chown=101:101 deploy/nginx-games.conf /etc/nginx/conf.d/default.conf
COPY --from=assets --chown=101:101 /dist/ /usr/share/nginx/html/
USER root
RUN printf '%s\n' "$SOURCE_COMMIT" > /usr/share/nginx/html/revision.txt
USER 101
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz
