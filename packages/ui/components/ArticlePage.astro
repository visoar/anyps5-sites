---
import Layout from './Layout.astro';
import Icon from './Icon.astro';
import DevelopmentNotes from './DevelopmentNotes.astro';
import {gameCopy} from '../../content/game-copy';
import {relatedArticles} from '../../content/article-links';
import {articles} from '../../content/articles';
import {extraArticles,policyArticles} from '../../content/extra-articles';
import {developmentArticle} from '../../content/development-article';
import {localPath,origin,t,dateLabel,codeLabel,type Locale,type Site} from '../../content/locales';
import {REVIEW_DATE,type Article} from '../../content/model';
const {article,locale,site}=Astro.props as {article:Article;locale:Locale;site:Site};
const path='/'+article.slug+'/';
const reviewDate=article.slug==='privacy'?'2026-10-12':REVIEW_DATE;
const allArticles=[...articles,...extraArticles,developmentArticle,...policyArticles];
const related=(relatedArticles[article.slug]||[]).filter(slug=>site==='cc'||policyArticles.some(a=>a.slug===slug)).map(slug=>allArticles.find(a=>a.slug===slug)!);
---
<Layout {locale} {site} {path} title={article.title[locale]} description={article.description[locale]} structured={{'@context':'https://schema.org','@type':['privacy','terms','about'].includes(article.slug)?'WebPage':'TechArticle',headline:article.title[locale],description:article.description[locale],inLanguage:locale,url:origin(site)+localPath(path,locale),dateModified:reviewDate,author:{'@type':'Organization',name:'AnyPS5 community resources'}}}>
 <div class="wrap article-shell">
  <aside class="toc"><a class="back-link" href={localPath('/',locale)}><Icon name="arrowRight"/>{t(locale,'home')}</a><p class="eyebrow">{t(locale,'onThisPage')}</p><nav>{article.sections.map(section=><a href={'#'+section.id}>{section.title[locale]}</a>)}{article.slug==='development-notes'&&<a href="#developments">{gameCopy.progress[locale]}</a>}{article.sources.length>0&&<a href="#sources">{t(locale,'sources')}</a>}</nav><a class="toc-related" href={origin(site==='cc'?'games':'cc')+localPath('/',locale)}>{t(locale,site==='cc'?'compatibility':'guide')}<Icon/></a></aside>
  <article class="article"><header class="article-heading"><p class="eyebrow">AnyPS5 {site==='cc'?t(locale,'guide'):t(locale,'sourcePolicy')}</p><h1>{article.title[locale]}</h1><p class="lede">{article.description[locale]}</p><p class="meta"><Icon name="clock"/>{t(locale,'reviewed')} · <time datetime={reviewDate}>{dateLabel(reviewDate,locale)}</time></p></header>
   {article.sections.map((section,index)=><section class="article-section" id={section.id}><h2>{section.title[locale]}</h2>{section.body.map(p=><p>{p[locale]}</p>)}{section.code&&<div class="code-block"><div class="code-toolbar"><span>{section.code.startsWith('runtime/')||section.code.startsWith('anyps5-fonts/')?codeLabel[locale].files:section.code.includes('ANYPS5_LANGUAGE')||section.code.includes(' = KEY:')?codeLabel[locale].reference:codeLabel[locale].terminal}</span><button class="copy-button" data-copy={'code-'+index} data-success={t(locale,'copied')} data-error={t(locale,'copyFailed')}><Icon name="copy"/>{t(locale,'copy')}</button></div><pre dir="ltr"><code id={'code-'+index}>{section.code}</code></pre><span class="copy-status" role="status" aria-live="polite"/></div>}{section.links&&<ul class="source-list">{section.links.map(link=><li><a href={link.url}><bdi>{link.label}</bdi><Icon name={article.slug==='downloads'?'download':'arrow'}/></a></li>)}</ul>}</section>)}
   {article.slug==='development-notes'&&<section class="article-section" id="developments"><h2>{gameCopy.progress[locale]}</h2><DevelopmentNotes {locale}/></section>}
   {article.sources.length>0&&<section class="article-section" id="sources"><h2>{t(locale,'sources')}</h2><ul class="source-list">{article.sources.map((url,i)=><li><a href={url}><span>{i+1}. <bdi>{decodeURIComponent(url.split('/').at(-1)!)||'GitHub'}</bdi></span><Icon/></a></li>)}</ul></section>}
   {related.length>0&&<section class="article-section"><h2>{t(locale,'related')}</h2><nav class="related-links">{related.map(a=><a href={localPath('/'+a.slug+'/',locale)}>{a.title[locale]}</a>)}</nav></section>}
   <nav class="article-next"><a href={localPath(site==='cc'?'/troubleshooting/':'/methodology/',locale)}><Icon name="book"/>{t(locale,site==='cc'?'troubleshooting':'methodology')}<Icon/></a><a href={origin(site==='cc'?'games':'cc')+localPath('/',locale)}><Icon name="gamepad"/>{t(locale,site==='cc'?'compatibility':'guide')}<Icon/></a></nav>
  </article>
 </div>
</Layout>
