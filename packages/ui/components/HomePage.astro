---
import Layout from './Layout.astro';
import Icon from './Icon.astro';
import {Image} from 'astro:assets';
import {gameArtwork,imageWidths} from '../game-media';
import {gameName,editorial,genreLabel} from '../../content/game-editorial';
import {gameCopy} from '../../content/game-copy';
import {localPath,origin,t,dateLabel,reportCount,resultFormats,type Locale,type Site} from '../../content/locales';
import {games,bestStage,stageNeedsPatches} from '../../content/games';
import {articles} from '../../content/articles';
import {extraArticles} from '../../content/extra-articles';
import {REVIEW_DATE,UPSTREAM} from '../../content/model';
const {locale,site}=Astro.props as {locale:Locale;site:Site};
const portal=site==='cc';
const title=t(locale,portal?'ccTitle':'gamesTitle');
const intro=t(locale,portal?'ccIntro':'gamesIntro');
const featured=['dreaming-sarah','hollow-knight-silksong','balatro','animal-well'];
const ordered=[...games].sort((a,b)=>{const ai=featured.indexOf(a.slug),bi=featured.indexOf(b.slug);return (ai<0?100:ai)-(bi<0?100:bi)||a.name.localeCompare(b.name)});
const tested=games.filter(g=>g.reports.length).length;
const pending=games.length-tested;
const guideSlugs=['guides/windows','guides/linux','guides/build','guides/input','guides/language-fonts','requirements'];
const faq=extraArticles.find(a=>a.slug==='faq')!;
const structured={'@context':'https://schema.org','@type':'WebSite',name:portal?'AnyPS5.cc':'AnyPS5.games',url:origin(site)+localPath('/',locale),description:intro,inLanguage:locale};
const artwork=Object.fromEntries(games.map(game=>[game.slug,gameArtwork(game.slug)]));
---
<Layout {locale} {site} {title} description={intro} {structured}>
 <section class:list={['hero',portal?'portal-hero':'games-hero']}>
  <div class="wrap hero-inner"><p class="eyebrow"><span class="live-dot"/>{t(locale,portal?'ccEyebrow':'gamesEyebrow')}</p><h1>{title}</h1><p class="hero-description">{intro}</p>
   {portal?<div class="hero-actions"><a class="button primary" href={localPath('/start/',locale)}>{t(locale,'start')}<Icon name="arrowRight"/></a><a class="button secondary" href={origin('games')+localPath('/',locale)}>{t(locale,'explore')}<Icon/></a></div>:<form id="game-search" class="search-form" role="search" action={localPath('/',locale)}><label class="sr-only" for="q">{t(locale,'searchLabel')}</label><Icon name="search"/><input type="search" name="q" id="q" placeholder={t(locale,'searchPlaceholder')} autocomplete="off"/><button type="submit">{t(locale,'search')}<Icon name="arrowRight"/></button></form>}
   <p class="hero-note"><Icon name="git"/>{portal?'v0.1.1 · '+t(locale,'release'):t(locale,'sourceOnly')}</p>
  </div>
 </section>
 {portal?<div class="wrap portal-content">
  <section class="steps" aria-label={t(locale,'start')}>{[1,2,3].map((step)=><a class="step" href={step===1?origin('games')+localPath('/',locale):localPath(step===2?'/downloads/':'/start/',locale)}><span class="step-number"><Icon name={step===1?'file':step===2?'wrench':'folder'}/></span><div><h2>{t(locale,('step'+step) as Parameters<typeof t>[1])}<Icon/></h2><p>{t(locale,('step'+step+'Text') as Parameters<typeof t>[1])}</p></div></a>)}</section>
  <section class="release-strip"><div><span class="release-pill">v0.1.1</span><span><strong>{t(locale,'release')}</strong><small><time datetime="2026-09-28">{dateLabel('2026-09-28',locale)}</time> · Windows / Linux</small></span></div><a href={localPath('/downloads/',locale)}>{t(locale,'downloadTools')}<Icon name="download"/></a></section>
  <section class="guide-section"><div class="section-heading"><div><p class="eyebrow">01 / {t(locale,'guide')}</p><h2>{t(locale,'readGuide')}</h2></div><a href={localPath('/faq/',locale)}>{t(locale,'faq')}<Icon/></a></div><div class="guide-grid">{guideSlugs.map((slug,i)=>{const a=articles.find(a=>a.slug===slug)!;return <a class="guide-card" href={localPath('/'+slug+'/',locale)}><span class="guide-index">0{i+1}</span><div><h3>{a.title[locale]}</h3><p>{a.description[locale]}</p></div><Icon/></a>})}</div></section>
  <nav class="editorial-nav"><a href={localPath('/development-notes/',locale)}>{gameCopy.progress[locale]}<Icon/></a><a href={localPath('/troubleshooting/',locale)}>{t(locale,'troubleshooting')}<Icon/></a></nav>
  <section class="progress-banner"><div><p class="eyebrow">02 / {t(locale,'progress')}</p><h2>{extraArticles.find(a=>a.slug==='progress')!.title[locale]}</h2><p>{extraArticles.find(a=>a.slug==='progress')!.description[locale]}</p><a class="text-link" href={localPath('/progress/',locale)}>{t(locale,'readMore')}<Icon name="arrowRight"/></a></div><div class="progress-value"><strong>2,839<span> / 3,318</span></strong><div class="progress-track"><span style="width:85.56%"/></div><p><bdi>85.56%</bdi> · {t(locale,'reviewed')} {dateLabel(REVIEW_DATE,locale)}</p></div></section>
  <section class="faq-section"><div class="section-heading"><div><p class="eyebrow">03 / {t(locale,'faq')}</p><h2>{faq.title[locale]}</h2></div></div>{faq.sections.map(section=><details class="faq-item"><summary>{section.title[locale]}<Icon name="caret"/></summary><div>{section.body.map(p=><p>{p[locale]}</p>)}</div></details>)}<a class="text-link" href={localPath('/troubleshooting/',locale)}>{t(locale,'troubleshooting')}<Icon name="arrowRight"/></a></section>
 </div>:<div class="wrap catalog-content">
  <section class="catalog" aria-labelledby="catalog-heading">
   <div class="section-heading"><div><p class="eyebrow">{t(locale,'reviewed')} · {dateLabel(REVIEW_DATE,locale)}</p><h2 id="catalog-heading">{t(locale,'compatibility')}<span class="heading-count">{games.length}</span></h2></div><a href={localPath('/methodology/',locale)}>{t(locale,'methodology')}<Icon/></a></div>
   <nav class="catalog-tabs"><a href={localPath('/tested/',locale)}>{gameCopy.testedList[locale]} <span>{tested}</span></a><a href={localPath('/untested/',locale)}>{gameCopy.watchlist[locale]} <span>{pending}</span></a></nav>
   <form id="game-filters" class="filter-bar">
    <label>{t(locale,'platform')}<span class="filter-select"><select name="platform" id="platform"><option value="">{t(locale,'all')}</option><option value="windows">Windows</option><option value="linux">Linux</option></select><Icon name="caret"/></span></label>
    <label>{t(locale,'stage')}<span class="filter-select"><select name="stage" id="stage"><option value="">{t(locale,'all')}</option>{['ingame','menu','boot','blocked','notTested'].map(stage=><option value={stage}>{t(locale,stage as Parameters<typeof t>[1])}</option>)}</select><Icon name="caret"/></span></label>
    <label>{t(locale,'evidence')}<span class="filter-select"><select name="evidence" id="evidence"><option value="">{t(locale,'all')}</option><option value="official">{t(locale,'official')}</option><option value="community">{t(locale,'community')}</option></select><Icon name="caret"/></span></label>
    <div class="filter-actions"><button type="button" id="reset-filters">{t(locale,'reset')}</button><button type="button" id="share-search" data-success={t(locale,'copied')} data-error={t(locale,'copyFailed')}><Icon name="copy"/>{t(locale,'saveSearch')}</button><span id="share-status" role="status" aria-live="polite"/></div>
   </form>
   <div class="catalog-status"><p id="result-count" role="status" aria-live="polite">{resultFormats[locale].other.replace('{count}',String(games.length))}</p><p class="filter-help">{t(locale,'filterHelp')}</p></div>
   <div class="game-table"><div class="table-header" aria-hidden="true"><span>{t(locale,'game')}</span><span>{t(locale,'platform')}</span><span>{t(locale,'stage')}</span><span>{t(locale,'evidence')}</span><span/></div>
    {ordered.map((game,i)=><a class="game-row" href={localPath('/games/'+game.slug+'/',locale)} data-game={game.slug} data-search={game.name+' '+(game.titleId||'')+' '+(editorial[game.slug]?.chineseName||'')}><span class="game-cell"><span class="game-thumbnail">{artwork[game.slug]?.cover?<Image src={artwork[game.slug]!.cover!} alt="" width={96} height={112} fit="cover" widths={imageWidths(artwork[game.slug]!.cover!,[48,96])} sizes="(max-width: 600px) 34px, 44px" format="webp" quality={82} loading="lazy" decoding="async"/>:<Icon name="gamepad"/>}</span><span><strong dir="auto">{gameName(game,locale)}</strong><small>{game.titleId&&<><bdi>{game.titleId}</bdi> · </>}{game.reports.length?reportCount(locale,game.reports.length):'PS5 · '+genreLabel(game.slug,locale)}</small></span></span><span class="platform-cell">{!game.reports.length&&<span class="unknown">—</span>}{Array.from(new Set(game.reports.map(r=>r.platform))).map(p=><span class="platform-chip" data-platform={p}>{p==='windows'?'Windows':'Linux'}</span>)}</span><span><span data-stage class:list={['badge',stageNeedsPatches(game)?'experimental':bestStage(game)]}>{t(locale,bestStage(game))}</span><small class="patch-note" data-patch hidden={!stageNeedsPatches(game)}>{t(locale,'localPatch')}</small></span><span class="evidence-cell"><Icon name="book"/><span data-evidence-label>{!game.reports.length?gameCopy.details[locale]:t(locale,game.reports.some(r=>r.evidence==='official')?'official':'community')}</span></span><Icon/></a>)}
   </div>
   <div id="empty-state" class="empty-state" hidden><Icon name="search"/><h3>{t(locale,'noResults')}</h3><p>{t(locale,'noResultsText')}</p><button type="button" id="empty-reset" class="button secondary">{t(locale,'reset')}</button></div>
   <noscript><p class="notice">{t(locale,'noResultsText')} · <a href={localPath('/methodology/',locale)}>{t(locale,'methodology')}</a></p></noscript>
   <p class="notice"><Icon name="git"/>{t(locale,'experimentalNote')}</p>
  </section>
  <section class="contribute-banner"><div><p class="eyebrow">{t(locale,'evidence')}</p><h2>{t(locale,'contribute')}</h2><p>{t(locale,'conditions')}</p></div><a class="button primary" href={localPath('/contribute/',locale)}>{t(locale,'reportTemplate')}<Icon name="arrowRight"/></a></section>
 </div>}
 {site==='games'&&<script id="catalog-data" type="application/json" set:html={JSON.stringify({games:games.map(g=>({slug:g.slug,reports:g.reports.map(r=>({platform:r.platform,stage:r.stage,evidence:r.evidence,patched:r.patched}))})),resultFormats:resultFormats[locale],labels:{details:gameCopy.details[locale],...Object.fromEntries(['ingame','menu','boot','blocked','notTested','official','community'].map(key=>[key,t(locale,key as Parameters<typeof t>[1])]))}}).replace(/</g,'\\u003c')}/>}
 <script>
  import '../catalog';
 </script>
</Layout>
