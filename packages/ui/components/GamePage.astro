---
import {growthCopy,caseNotes} from '../../content/growth-content';
import {gameSearchMetadata} from '../../content/compatibility-report';
import Layout from './Layout.astro';
import PlatformSummary from './PlatformSummary.astro';
import {discoveryCopy} from '../../content/discovery-copy';
import Icon from './Icon.astro';
import {Image} from 'astro:assets';
import {gameArtwork,imageWidths} from '../game-media';
import DevelopmentNotes from './DevelopmentNotes.astro';
import EvidenceReview from './EvidenceReview.astro';
import {gameResearch,researchCopy} from '../../content/game-research';
import {editorial,media,gameName,genreLabel} from '../../content/game-editorial';
import {gameCopy} from '../../content/game-copy';
import {developmentNotes} from '../../content/github-progress';
import {localPath,origin,t,dateLabel,reportCount,type Locale} from '../../content/locales';
import {games} from '../../content/games';
import {REVIEW_DATE,type Game} from '../../content/model';
const {game,locale}=Astro.props as {game:Game;locale:Locale};
const path='/games/'+game.slug+'/';
const info=editorial[game.slug];
const research=gameResearch[game.slug];
const reviewDate=game.reviewed||REVIEW_DATE;
const source=media[game.slug];
const artwork=gameArtwork(game.slug);
const ogImage=artwork?.cover?{src:artwork.cover.src,width:artwork.cover.width,height:artwork.cover.height,type:'image/webp'}:undefined;
const name=gameName(game,locale);
const identityNote=gameCopy.identityNote[locale].split('{id}');
const contentVersions=[...new Set(game.reports.map(report=>report.version||t(locale,'unknown')))];
const {title,description}=gameSearchMetadata(game,locale);
const hasProgress=developmentNotes.some(n=>n.games.includes(game.slug));
const structured={'@context':'https://schema.org','@type':'Article',headline:title,description,inLanguage:locale,url:origin('games')+localPath(path,locale),dateModified:reviewDate,...(ogImage?{image:{'@type':'ImageObject',url:new URL(ogImage.src,origin('games')).href,width:ogImage.width,height:ogImage.height}}:{}),about:{'@type':'VideoGame',name:game.name,...(game.titleId?{identifier:game.titleId}:{})},citation:[...new Set([...game.reports.map(r=>r.source),...(source?[source.source]:[]),...(research?.sources.map(s=>s.url)||[])])],author:{'@type':'Organization',name:'AnyPS5 community resources'}};
---
<Layout {locale} site="games" {path} title={title} {description} structured={[structured,{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:t(locale,'compatibility'),item:origin('games')+localPath('/',locale)},{'@type':'ListItem',position:2,name,item:origin('games')+localPath(path,locale)}]}]} ogType="article" {ogImage}>
 <div class="wrap game-detail"><a class="back-link" href={localPath('/',locale)}><Icon name="arrowRight"/>{t(locale,'backGames')}</a><header class="game-heading"><div><p class="eyebrow">{game.titleId&&<><bdi>{game.titleId}</bdi> / </>}{genreLabel(game.slug,locale)}</p><h1 dir="auto">{name}</h1>{name!==game.name&&<p class="original-title" dir="auto">{game.name}</p>}<p class="lede">{description}</p></div><span class="badge large unverified">{t(locale,game.reports.length?'reported':'notTested')}<Icon name="git"/></span></header>
 <div class="game-meta"><span>{game.reports.length?reportCount(locale,game.reports.length):t(locale,'notTested')}</span><span><Icon name="clock"/>{t(locale,'lastReview')} {dateLabel(reviewDate,locale)}</span><a href={localPath('/methodology/',locale)}>{t(locale,'methodology')}<Icon/></a></div>
 {game.titleId&&<p class="identity-check">{identityNote[0]}<bdi>{game.titleId}</bdi>{identityNote[1]}</p>}
 <PlatformSummary {game} {locale}/><div class="game-layout"><aside class="toc game-toc"><p class="eyebrow">{t(locale,'onThisPage')}</p><nav><a href="#platform-summary">{discoveryCopy.platformSummary[locale]}</a><a href="#overview">{gameCopy.overview[locale]}</a>{research&&<a href="#research">{researchCopy.title[locale]}</a>}{hasProgress&&<a href="#development">{gameCopy.progress[locale]}</a>}{game.reports.map(r=><a href={'#report-'+r.id}>{t(locale,r.platform)} · {t(locale,r.evidence)}</a>)}{!game.reports.length&&<a href="#status">{gameCopy.status[locale]}</a>}<a href="#identity">{t(locale,'identity')}</a><a href="#media">{t(locale,'media')}</a></nav><p>{t(locale,'sourceOnly')}</p></aside><div class="reports">
  <section id="overview" class="detail-section game-overview"><h2>{gameCopy.overview[locale]}</h2>{artwork?.cover&&<Image class="game-cover" src={artwork.cover} alt={name+' — '+gameCopy.officialMedia[locale]} width={Math.min(360,artwork.cover.width)} widths={imageWidths(artwork.cover,[180,360])} sizes="(max-width: 600px) 124px, 180px" format="webp" quality={82} loading="eager" decoding="async"/>}<p>{info.overview[locale]}</p><h3>{research?researchCopy.edition[locale]:gameCopy.edition[locale]}</h3><p>{research?.edition[locale]||info.editionNote[locale]}</p>{artwork&&<a class="text-link" href={source.source}>{gameCopy.officialPage[locale]}<Icon/></a>}</section>
  {caseNotes[game.slug as keyof typeof caseNotes]&&<section class="detail-section"><h2>{growthCopy.nextCheck[locale]}</h2><p>{caseNotes[game.slug as keyof typeof caseNotes][locale]}</p><a class="text-link" href={localPath('/compatibility-report/',locale)+'#'+game.slug}>{growthCopy.reportTitle[locale]}<Icon/></a></section>}
  {research&&<EvidenceReview {research} {locale}/>}
  {!game.reports.length&&<section class="report-card untested-card" id="status"><p class="eyebrow">{gameCopy.status[locale]}</p><h2>{t(locale,'notTested')}</h2><p>{gameCopy.noReport[locale]}</p><p>{gameCopy.noMetrics[locale]}</p><a class="text-link" href={localPath('/contribute/',locale)}>{t(locale,'reportTemplate')}<Icon/></a></section>}
  {hasProgress&&<section id="development" class="detail-section"><h2>{gameCopy.progress[locale]}</h2><DevelopmentNotes {locale} gameSlug={game.slug}/></section>}
  {game.reports.map(report=><section class="report-card" id={'report-'+report.id}><div class="report-heading"><div><p class="eyebrow">{t(locale,report.evidence)} · {t(locale,report.platform)}</p><h2>{t(locale,report.stage)}</h2></div><span class:list={['badge',report.patched?'experimental':'unverified']}>{t(locale,report.patched?'localPatch':'reported')}</span></div><p class="report-summary">{report.summary[locale]}</p>
   <dl class="report-fields">{[[t(locale,'build'),report.build],[t(locale,'platform'),report.os],[t(locale,'version'),report.version],[t(locale,'cpu'),report.cpu],[t(locale,'gpu'),report.gpu],[t(locale,'driver'),report.driver],[t(locale,'testDate'),report.testDate?dateLabel(report.testDate,locale):null]].map(([label,value])=><div><dt>{label}</dt><dd>{value?<bdi>{value}</bdi>:<span class="unknown">{t(locale,'unknown')}</span>}</dd></div>)}</dl>
   <div class="benchmark-section"><h3>{t(locale,'benchmarks')}</h3>{report.benchmarks.length?report.benchmarks.map(b=><div class="benchmark"><strong dir="auto">{typeof b.fps==='string'?b.fps:b.fps[locale]}<small>FPS</small></strong><p><bdi>{b.gpu}</bdi><br/><span><bdi>{b.cpu||t(locale,'unknown')}</bdi></span></p><span class="benchmark-source">{t(locale,'reported')}</span></div>):<p class="muted">{t(locale,'noBenchmark')}</p>}</div>
   <details class="scope-detail"><summary>{t(locale,'scope')}<Icon name="caret"/></summary><p>{report.summary[locale]}</p><p>{t(locale,'sourceOnly')} {t(locale,'experimentalNote')}</p></details>
   <div class="report-source"><a href={report.source}>{t(locale,'viewSource')}<Icon/></a><span>{t(locale,'sourceDate')} {report.updated?<time datetime={report.updated}>{dateLabel(report.updated,locale)}</time>:t(locale,'unknown')}</span></div>
  </section>)}
  <section id="identity" class="detail-section"><h2>{t(locale,'identity')}</h2><dl class="report-fields"><div><dt>{t(locale,'game')}</dt><dd dir="auto">{game.name}</dd></div><div><dt>{t(locale,'titleId')}</dt><dd>{game.titleId?<bdi>{game.titleId}</bdi>:t(locale,'unknown')}</dd></div><div><dt>{t(locale,'edition')}</dt><dd>{game.edition||t(locale,'unknown')}</dd></div>{game.reports.length>0&&<div><dt>{gameCopy.reportVersions[locale]}</dt><dd>{contentVersions.map((version,index)=><>{index>0&&' · '}<bdi>{version}</bdi></>)}</dd></div>}</dl><p>{gameCopy.versionScope[locale]}</p></section>
  <section id="media" class="detail-section"><h2>{t(locale,'media')}</h2>{artwork&&<><h3>{gameCopy.officialMedia[locale]}</h3><p>{gameCopy.mediaNote[locale]}</p>{artwork.screenshots.length>0&&<div class="official-gallery">{artwork.screenshots.map((image,i)=><a href={image.src}><Image src={image} alt={name+' — '+gameCopy.officialMedia[locale]+' '+(i+1)} width={Math.min(960,image.width)} widths={imageWidths(image,[480,960,1920])} sizes="(max-width: 600px) calc(100vw - 36px), (max-width: 900px) calc((100vw - 72px) / 2), (max-width: 1150px) calc((100vw - 287px) / 2), (max-width: 1300px) calc((100vw - 371px) / 2), 464.5px" format="webp" quality={82} loading="lazy" decoding="async"/></a>)}</div>}<a class="text-link" href={source.source}>{gameCopy.officialPage[locale]}<Icon/></a></>}<p>{t(locale,'sourceOnly')}</p><ul class="source-list">{game.reports.map(report=><li><a href={report.source}><span>{t(locale,report.platform)} · {t(locale,report.evidence)} · {t(locale,'viewSource')}</span><Icon/></a>{report.media.slice(0,3).map((url,index)=><a class="media-reference" href={url}><span>{t(locale,'media')} · {index+1} · <bdi>{new URL(url).hostname}</bdi></span><Icon/></a>)}</li>)}</ul><p class="muted">{t(locale,'sourcePolicy')} · <a href={localPath('/methodology/#corrections',locale)}>{t(locale,'readMore')}</a></p></section>
  <section class="detail-section"><h2>{gameCopy.prepare[locale]}</h2><p>{gameCopy.preparation[locale]}</p><nav class="related-links"><a href={origin('cc')+localPath('/guides/windows/',locale)}>Windows · {t(locale,'guide')}</a><a href={origin('cc')+localPath('/guides/linux/',locale)}>Linux · {t(locale,'guide')}</a><a href={origin('cc')+localPath('/troubleshooting/',locale)}>{t(locale,'troubleshooting')}</a></nav></section>
  <section class="detail-section"><h2>{gameCopy.related[locale]}</h2><nav class="related-links">{info.related.map(slug=><a href={localPath('/games/'+slug+'/',locale)}>{gameName(games.find(g=>g.slug===slug)!,locale)}</a>)}<a href={localPath('/methodology/',locale)}>{t(locale,'methodology')}</a></nav></section>
  <section class="contribute-banner compact"><div><h2>{t(locale,'contribute')}</h2><p>{t(locale,'conditions')}</p></div><a class="button primary" href={localPath('/contribute/',locale)}>{t(locale,'reportTemplate')}<Icon/></a></section>
 </div></div></div>
</Layout>
