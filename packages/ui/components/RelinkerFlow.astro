---
import Icon from './Icon.astro';
import {relinkerFlow as copy} from '../../content/relinker-flow';
import type {Locale} from '../../content/locales';
const {locale}=Astro.props as {locale:Locale};
const steps=[
 {title:copy.input,detail:copy.inputDetail},
 {title:copy.relinker,detail:copy.relinkerDetail},
 {title:copy.output,detail:copy.outputDetail}
];
---
<figure class="relinker-flow" aria-labelledby="relinker-flow-caption">
 <div class="flow-content">
  <p class="flow-phase">{copy.conversion[locale]}</p>
  <ol class="flow-steps">
   {steps.map((step,index)=><li class="flow-card"><span class="flow-number" aria-hidden="true">{index+1}</span><strong>{step.title[locale]}</strong><p>{step.detail[locale]}</p>{index<steps.length-1&&<span class="flow-connector" aria-hidden="true"><Icon name="arrowRight"/></span>}</li>)}
  </ol>
  <div class="flow-down" aria-hidden="true"><Icon name="arrowRight"/></div>
  <p class="flow-phase">{copy.runtime[locale]}</p>
  <p class="flow-prepare">{copy.prepare[locale]}</p>
  <div class="flow-dependencies">
   <div class="flow-card"><bdi class="flow-path" dir="ltr">libs/</bdi><strong>{copy.libraries[locale]}</strong><p>{copy.librariesDetail[locale]}</p></div>
   <div class="flow-card"><bdi class="flow-path" dir="ltr">app0/</bdi><strong>{copy.resources[locale]}</strong><p>{copy.resourcesDetail[locale]}</p></div>
  </div>
  <div class="flow-down" aria-hidden="true"><Icon name="arrowRight"/></div>
  <div class="flow-card flow-result"><strong>{copy.run[locale]}</strong><p>{copy.runDetail[locale]}</p></div>
 </div>
 <figcaption id="relinker-flow-caption">{copy.caption[locale]}</figcaption>
</figure>
<style>
 .relinker-flow{container-type:inline-size;margin:26px 0 0;min-width:0}
 .flow-content{padding:24px;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
 .flow-phase{font-size:12px;font-weight:650;color:var(--ink);margin:0 0 16px}
 .flow-steps{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:minmax(0,1fr);gap:34px}
 .flow-card{position:relative;min-width:0;padding:18px;border:1px solid var(--line);border-radius:6px;background:var(--bg);overflow-wrap:anywhere}
 .flow-card strong{display:block;font-size:15px;line-height:1.6;color:var(--ink)}
 .flow-card p,.flow-prepare{font-size:13px;line-height:1.8;color:var(--muted);margin:8px 0 0}
 .flow-number,.flow-path{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:8px}
 .flow-connector{position:absolute;inset-inline-start:calc(50% - 11px);bottom:-29px;display:flex;width:22px;height:22px;transform:rotate(90deg);color:var(--muted)}
 .flow-connector :global(.icon),.flow-down :global(.icon){width:22px;height:22px}
 .flow-down{display:flex;justify-content:center;padding-block:14px;color:var(--muted)}
 .flow-down :global(.icon){transform:rotate(90deg)}
 .flow-prepare{margin:0 0 16px}
 .flow-dependencies{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
 .flow-result{border-inline-start:3px solid var(--accent)}
 figcaption{font-size:12px;line-height:1.8;color:var(--muted);margin-top:12px}
 @container(min-width:480px){.flow-dependencies{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @container(min-width:640px){
  .flow-steps{grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}
  .flow-connector{inset-inline-start:auto;inset-inline-end:-27px;top:calc(50% - 11px);bottom:auto;transform:none}
  :global([dir=rtl]) .flow-connector{transform:rotate(180deg)}
 }
 @container(max-width:360px){.flow-content{padding:16px}.flow-card{padding:16px}}
</style>
