---
const {text}=Astro.props as {text:string};
const tokens=text.split(/(--macos --to-rosetta|--[a-z][a-z0-9-]*|\b(?:ANYPS5|APS5)_[A-Z0-9_]+|\/_sd|\/download0|\b_sd\b|\bapp0\/|\blibs\/|x86-64)/g);
---
{tokens.map((token,index)=>index%2?<bdi dir="ltr"><code>{token}</code></bdi>:token)}
<style>code{font-size:.92em;white-space:nowrap;overflow-wrap:normal}</style>
